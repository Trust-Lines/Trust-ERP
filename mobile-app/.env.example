# Copy to .env.local (git-ignored) and fill in.
# Same Supabase project as the web platform (trustlines-platform-master/.env.local)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# The platform's base URL — the app calls its /api/* routes with the user's Supabase token.
# On a phone in dev use your computer's LAN IP, e.g. http://192.168.1.20:3000
EXPO_PUBLIC_API_URL=https://t-erp.vercel.app
